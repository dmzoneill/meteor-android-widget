<?xml version='1.0' encoding='UTF-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/configureButton" android:layout_width="fill_parent" android:layout_height="fill_parent">
    <ImageView android:id="@+id/backgroundImage" android:src="@drawable/bg_cyan" style="@style/MeteorLayoutImageView4"/>
